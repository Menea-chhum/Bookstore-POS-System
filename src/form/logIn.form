<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="form.logIn">
  <grid id="27dc6" binding="mainPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="500" height="486"/>
    </constraints>
    <properties>
      <background color="-1773060"/>
    </properties>
    <border type="none"/>
    <children>
      <grid id="b93ba" layout-manager="GridBagLayout">
        <constraints border-constraint="Center"/>
        <properties>
          <background color="-1773060"/>
        </properties>
        <border type="none"/>
        <children>
          <grid id="e95d7" binding="LoginCard" layout-manager="GridLayoutManager" row-count="10" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="20" left="20" bottom="20" right="20"/>
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
              <gridbag weightx="0.0" weighty="0.0"/>
            </constraints>
            <properties>
              <background color="-1"/>
              <doubleBuffered value="true"/>
              <foreground color="-1"/>
              <preferredSize width="400" height="500"/>
            </properties>
            <border type="none"/>
            <children>
              <component id="b0754" class="javax.swing.JLabel" binding="storeLogo">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <enabled value="true"/>
                  <icon value="image/logo64x64.jpg"/>
                  <iconTextGap value="0"/>
                  <text value=""/>
                </properties>
              </component>
              <component id="4dd45" class="javax.swing.JLabel">
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <font name="Consolas" size="26" style="1"/>
                  <foreground color="-15388337"/>
                  <text value="Inkwell Books"/>
                </properties>
              </component>
              <component id="4d35d" class="javax.swing.JLabel">
                <constraints>
                  <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <font name="Consolas" size="20" style="0"/>
                  <foreground color="-15388337"/>
                  <text value="Bookstore POS System"/>
                </properties>
              </component>
              <component id="55028" class="javax.swing.JLabel">
                <constraints>
                  <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <font name="Consolas" size="19" style="0"/>
                  <text value="Username "/>
                </properties>
              </component>
              <component id="33ffd" class="javax.swing.JLabel">
                <constraints>
                  <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <font name="Consolas" size="18" style="0"/>
                  <text value="Password"/>
                </properties>
              </component>
              <component id="abeaf" class="javax.swing.JButton" binding="logInButton" default-binding="true">
                <constraints>
                  <grid row="7" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <background color="-13926447"/>
                  <font name="Consolas" size="22" style="1"/>
                  <foreground color="-1"/>
                  <hideActionText value="false"/>
                  <text value="Log in"/>
                </properties>
              </component>
              <component id="1f38f" class="javax.swing.JLabel">
                <constraints>
                  <grid row="8" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <font name="Consolas" size="15" style="0"/>
                  <foreground color="-5393738"/>
                  <text value="Enter your name and password to continue"/>
                </properties>
              </component>
              <component id="213d0" class="javax.swing.JTextField" binding="usernameInput">
                <constraints>
                  <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                    <preferred-size width="150" height="-1"/>
                  </grid>
                </constraints>
                <properties>
                  <background color="-656642"/>
                  <columns value="0"/>
                  <font name="Consolas" size="18" style="0"/>
                  <horizontalAlignment value="10"/>
                </properties>
              </component>
              <component id="4d092" class="javax.swing.JPasswordField" binding="passwordInput">
                <constraints>
                  <grid row="6" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                    <preferred-size width="150" height="-1"/>
                  </grid>
                </constraints>
                <properties>
                  <background color="-656642"/>
                  <font name="Consolas" size="18" style="0"/>
                </properties>
              </component>
              <component id="94a73" class="javax.swing.JLabel" binding="failMsg">
                <constraints>
                  <grid row="9" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value=""/>
                </properties>
              </component>
            </children>
          </grid>
        </children>
      </grid>
    </children>
  </grid>
</form>
